# Multi-Plan Telecommunications Cost Optimization

plans = []

n = int(input("Enter number of mobile plans: "))

print("\nEnter your usage details")
data_required = float(input("Monthly data required (GB): "))
calls_required = int(input("Monthly call minutes required: "))
validity_required = int(input("Minimum validity required (days): "))
budget = float(input("Maximum budget (Rs.): "))

for i in range(n):
    print(f"\nEnter details for Plan {i + 1}")

    name = input("Plan name: ")
    price = float(input("Plan price (Rs.): "))
    data_limit = float(input("Included data (GB): "))
    call_limit = int(input("Included call minutes: "))
    validity = int(input("Validity (days): "))
    extra_data_rate = float(input("Extra data charge per GB (Rs.): "))
    extra_call_rate = float(input("Extra call charge per minute (Rs.): "))

    if (price < 0 or data_limit < 0 or call_limit < 0
            or validity < 0 or extra_data_rate < 0
            or extra_call_rate < 0):
        print("Invalid plan details. Skipping this plan.")
        continue

    excess_data = max(0, data_required - data_limit)
    excess_calls = max(0, calls_required - call_limit)

    extra_data_cost = excess_data * extra_data_rate
    extra_call_cost = excess_calls * extra_call_rate

    total_cost = price + extra_data_cost + extra_call_cost

    eligible = (
        data_limit >= data_required
        and call_limit >= calls_required
        and validity >= validity_required
        and total_cost <= budget
    )

    plans.append({
        "name": name,
        "price": price,
        "data": data_limit,
        "calls": call_limit,
        "validity": validity,
        "excess_data": excess_data,
        "excess_calls": excess_calls,
        "extra_data_cost": extra_data_cost,
        "extra_call_cost": extra_call_cost,
        "total_cost": total_cost,
        "eligible": eligible
    })

print("\n========== PLAN COMPARISON ==========")

for plan in plans:
    print("\nPlan:", plan["name"])
    print(f"Base Price: Rs. {plan['price']:.2f}")
    print(f"Excess Data: {plan['excess_data']:.2f} GB")
    print(f"Excess Calls: {plan['excess_calls']} minutes")
    print(f"Extra Data Cost: Rs. {plan['extra_data_cost']:.2f}")
    print(f"Extra Call Cost: Rs. {plan['extra_call_cost']:.2f}")
    print(f"Total Cost: Rs. {plan['total_cost']:.2f}")
    print("Eligible:", "Yes" if plan["eligible"] else "No")

eligible_plans = [
    plan for plan in plans if plan["eligible"]
]

print("\n========== RECOMMENDATION ==========")

if eligible_plans:
    best_plan = min(
        eligible_plans,
        key=lambda plan: plan["total_cost"]
    )

    print("Most Economical Plan:", best_plan["name"])
    print(f"Total Cost: Rs. {best_plan['total_cost']:.2f}")
    print(f"Validity: {best_plan['validity']} days")
else:
    print("No plan satisfies all usage, validity, and budget constraints.")
    print("Consider increasing the budget or adjusting usage requirements.")
