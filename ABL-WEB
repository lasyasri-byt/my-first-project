<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NovaCart - Online Shopping</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            color: #222;
        }

        /* Navigation Bar */
        header {
            background: #111827;
            color: white;
            padding: 18px 6%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
            color: #60a5fa;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin-left: 20px;
            font-size: 14px;
        }

        nav a:hover {
            color: #60a5fa;
        }

        /* Hero Section */
        .hero {
            text-align: center;
            padding: 65px 20px;
            background: linear-gradient(135deg, #e0e7ff, #f3e8ff);
        }

        .hero h1 {
            font-size: 36px;
            margin-bottom: 15px;
        }

        .hero p {
            color: #555;
            margin-bottom: 22px;
        }

        .btn {
            background: #4169e1;
            color: white;
            padding: 12px 25px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
        }

        .btn:hover {
            background: #254ac7;
        }

        /* Products Section */
        .products {
            padding: 35px 6%;
            text-align: center;
        }

        .products h2 {
            margin-bottom: 25px;
            font-size: 26px;
        }

        .product-container {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .product-card {
            background: white;
            padding: 15px;
            border-radius: 10px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.1);
            transition: 0.3s;
        }

        .product-card:hover {
            transform: translateY(-5px);
        }

        .product-card img {
            width: 100%;
            height: 150px;
            object-fit: contain;
            border-radius: 5px;
            margin-bottom: 12px;
        }

        .product-card h3 {
            font-size: 17px;
            margin-bottom: 10px;
        }

        .rating {
            color: #f59e0b;
            margin-bottom: 8px;
        }

        .price {
            color: #1e40af;
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 12px;
        }

        .old-price {
            color: #888;
            font-size: 12px;
            text-decoration: line-through;
            margin-left: 5px;
        }

        .product-card button {
            background: #4169e1;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        .product-card button:hover {
            background: #254ac7;
        }

        /* Offers Section */
        .offers {
            margin: 10px 6% 35px;
            padding: 35px 20px;
            text-align: center;
            background: #111827;
            color: white;
            border-radius: 10px;
        }

        .offers h2 {
            margin-bottom: 15px;
        }

        .offers p {
            margin-bottom: 20px;
            color: #ddd;
        }

        /* Footer */
        footer {
            background: #111827;
            color: white;
            text-align: center;
            padding: 25px;
            font-size: 14px;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .product-container {
                grid-template-columns: repeat(2, 1fr);
            }

            .hero h1 {
                font-size: 28px;
            }

            nav a {
                margin-left: 8px;
                font-size: 12px;
            }
        }

        @media (max-width: 480px) {
            .product-container {
                grid-template-columns: 1fr;
            }

            header {
                flex-direction: column;
                gap: 15px;
            }
        }
    </style>
</head>

<body>

    <!-- Navigation -->
    <header>
        <div class="logo">NovaCart</div>

        <nav>
            <a href="#home">Home</a>
            <a href="#products">Products</a>
            <a href="#offers">Offers</a>
            <a href="#contact">Contact</a>
            <a href="#cart">Cart (0)</a>
        </nav>
    </header>

    <!-- Hero Section -->
    <section class="hero" id="home">
        <h1>Discover Amazing Products</h1>
        <p>Shop your favourite products at great prices</p>
        <a href="#products" class="btn">Shop Now</a>
    </section>

    <!-- Products Section -->
    <section class="products" id="products">
        <h2>Our Popular Products</h2>

        <div class="product-container">

            <!-- Product 1 -->
            <div class="product-card">
                <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=500&q=80"
                     alt="Wireless Headphones">

                <h3>Wireless Headphones</h3>
                <div class="rating">★★★★★ (4.8)</div>
                <div class="price">₹1,499 <span class="old-price">₹1,999</span></div>

                <button type="button">Add to Cart</button>
            </div>

            <!-- Product 2 -->
            <div class="product-card">
                <img src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&w=500&q=80"
                     alt="Smart Watch">

                <h3>Smart Watch</h3>
                <div class="rating">★★★★★ (4.5)</div>
                <div class="price">₹2,399 <span class="old-price">₹2,999</span></div>

                <button type="button">Add to Cart</button>
            </div>

            <!-- Product 3 -->
            <div class="product-card">
                <img src="https://images.unsplash.com/photo-1553062407-98eeb64c6a62?auto=format&fit=crop&w=500&q=80"
                     alt="Travel Backpack">

                <h3>Travel Backpack</h3>
                <div class="rating">★★★★☆ (4.2)</div>
                <div class="price">₹999</div>

                <button type="button">Add to Cart</button>
            </div>

            <!-- Product 4 -->
            <div class="product-card">
                <img src="https://images.unsplash.com/photo-1608043152269-423dbba4e7e1?auto=format&fit=crop&w=500&q=80"
                     alt="Bluetooth Speaker">

                <h3>Bluetooth Speaker</h3>
                <div class="rating">★★★★☆ (4.4)</div>
                <div class="price">₹1,099</div>

                <button type="button">Add to Cart</button>
            </div>

        </div>
    </section>

    <!-- Special Offers -->
    <section class="offers" id="offers">
        <h2>Special Shopping Offers!</h2>
        <p>Enjoy exciting discounts on selected products.</p>
        <a href="#products" class="btn">Explore Offers</a>
    </section>

    <!-- Footer -->
    <footer id="contact">
        <p>© 2026 NovaCart | Online Shopping Website</p>
        <p>Contact: support@novacart.example</p>
    </footer>

</body>
</html>
