# Campus Event Financial Planning

venue = float(input("Enter venue cost (Rs.): "))
equipment = float(input("Enter equipment cost (Rs.): "))
catering_per_person = float(input("Enter catering cost per participant (Rs.): "))
transport = float(input("Enter transport cost (Rs.): "))
certificate_per_person = float(input("Enter certificate cost per participant (Rs.): "))
participants = int(input("Enter expected number of participants: "))
registration_fee = float(input("Enter registration fee per participant (Rs.): "))
sponsorship = float(input("Enter sponsorship amount (Rs.): "))

if (min(venue, equipment, catering_per_person, transport,
        certificate_per_person, registration_fee, sponsorship) < 0
        or participants < 0):
    print("Invalid input!")
else:
    fixed_cost = venue + equipment + transport
    variable_cost_per_person = catering_per_person + certificate_per_person
    total_cost = fixed_cost + variable_cost_per_person * participants
    registration_income = registration_fee * participants
    total_income = registration_income + sponsorship
    surplus_or_shortfall = total_income - total_cost

    print("\n--- Campus Event Financial Report ---")
    print(f"Venue Cost: Rs. {venue:.2f}")
    print(f"Equipment Cost: Rs. {equipment:.2f}")
    print(f"Catering Cost: Rs. {catering_per_person * participants:.2f}")
    print(f"Transport Cost: Rs. {transport:.2f}")
    print(f"Certificate Cost: Rs. {certificate_per_person * participants:.2f}")
    print(f"Total Event Cost: Rs. {total_cost:.2f}")
    print(f"Registration Income: Rs. {registration_income:.2f}")
    print(f"Sponsorship: Rs. {sponsorship:.2f}")
    print(f"Total Income: Rs. {total_income:.2f}")

    if surplus_or_shortfall >= 0:
        print(f"Surplus: Rs. {surplus_or_shortfall:.2f}")
    else:
        print(f"Financial Shortfall: Rs. {-surplus_or_shortfall:.2f}")

    if registration_fee > variable_cost_per_person:
        remaining_fixed_cost = max(0, fixed_cost - sponsorship)
        break_even = int(
            remaining_fixed_cost
            / (registration_fee - variable_cost_per_person)
        )
        if (remaining_fixed_cost
                % (registration_fee - variable_cost_per_person)) > 0:
            break_even += 1

        print("Minimum Registrations to Break Even:", break_even)
    elif sponsorship >= fixed_cost:
        print("Minimum Registrations to Break Even: 0")
    else:
        print("Break-even is not possible at the current registration fee.")
