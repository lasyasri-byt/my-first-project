# Progressive Electricity Billing System

def calculate_bill(units):
    fixed_charge = 100

    if units <= 100:
        energy_charge = units * 1.50
    elif units <= 200:
        energy_charge = (100 * 1.50) + (units - 100) * 2.50
    elif units <= 300:
        energy_charge = (100 * 1.50) + (100 * 2.50) + (units - 200) * 4.00
    else:
        energy_charge = (
            (100 * 1.50)
            + (100 * 2.50)
            + (100 * 4.00)
            + (units - 300) * 6.00
        )

    surcharge = energy_charge * 0.05
    subtotal = energy_charge + fixed_charge + surcharge

    if units < 100:
        rebate = subtotal * 0.10
    else:
        rebate = 0

    total_bill = subtotal - rebate

    return energy_charge, fixed_charge, surcharge, rebate, total_bill


months = int(input("Enter number of months: "))
monthly_bills = []

for i in range(months):
    month = input(f"\nEnter month {i + 1} name: ")
    units = float(input("Enter electricity units consumed: "))

    energy, fixed, surcharge, rebate, total = calculate_bill(units)

    monthly_bills.append({
        "month": month,
        "units": units,
        "energy": energy,
        "fixed": fixed,
        "surcharge": surcharge,
        "rebate": rebate,
        "total": total
    })

    print("\n--- Electricity Bill ---")
    print("Month:", month)
    print("Units Consumed:", units)
    print(f"Energy Charges: Rs. {energy:.2f}")
    print(f"Fixed Charges: Rs. {fixed:.2f}")
    print(f"Surcharge: Rs. {surcharge:.2f}")
    print(f"Rebate: Rs. {rebate:.2f}")
    print(f"Total Bill: Rs. {total:.2f}")

print("\n--- Monthly Bill Comparison ---")

for i, bill in enumerate(monthly_bills):
    print(
        f"{bill['month']}: {bill['units']} units, "
        f"Bill = Rs. {bill['total']:.2f}"
    )

    if i > 0:
        previous_bill = monthly_bills[i - 1]["total"]
        increase = bill["total"] - previous_bill

        if previous_bill > 0:
            percentage = (increase / previous_bill) * 100
        else:
            percentage = 0

        print(f"Change from previous month: Rs. {increase:.2f}")

        if percentage > 30:
            print("Warning: Unusual increase in electricity bill!")
        elif increase > 0:
            print(f"Bill increased by {percentage:.2f}%")
        elif increase < 0:
            print(f"Bill decreased by {abs(percentage):.2f}%")
        else:
            print("Bill remains unchanged.")
