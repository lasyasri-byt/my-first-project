# Manufacturing Cost and Profitability Analysis

material_cost = float(input("Enter material cost (Rs.): "))
labour_cost = float(input("Enter labour charges (Rs.): "))
wastage_percent = float(input("Enter wastage percentage: "))
machine_cost = float(input("Enter machine cost (Rs.): "))
quantity = int(input("Enter production quantity: "))
selling_price = float(input("Enter selling price per unit (Rs.): "))
profit_target = float(input("Enter target profit percentage: "))

if (material_cost < 0 or labour_cost < 0 or machine_cost < 0
        or quantity <= 0 or selling_price < 0
        or not 0 <= wastage_percent <= 100 or profit_target < 0):
    print("Invalid input!")
else:
    wastage_cost = material_cost * wastage_percent / 100
    total_cost = material_cost + wastage_cost + labour_cost + machine_cost
    cost_per_unit = total_cost / quantity
    revenue = selling_price * quantity
    profit = revenue - total_cost
    profit_percent = (profit / total_cost * 100) if total_cost > 0 else 0

    print("\n--- Manufacturing Cost Report ---")
    print(f"Material Cost: Rs. {material_cost:.2f}")
    print(f"Wastage Cost: Rs. {wastage_cost:.2f}")
    print(f"Labour Cost: Rs. {labour_cost:.2f}")
    print(f"Machine Cost: Rs. {machine_cost:.2f}")
    print(f"Total Production Cost: Rs. {total_cost:.2f}")
    print(f"Cost Per Unit: Rs. {cost_per_unit:.2f}")
    print(f"Total Revenue: Rs. {revenue:.2f}")
    print(f"Profit/Loss: Rs. {profit:.2f}")
    print(f"Profit Percentage: {profit_percent:.2f}%")

    if profit_percent >= profit_target:
        print("Result: Target profit achieved.")
    else:
        print("Result: Target profit not achieved.")
