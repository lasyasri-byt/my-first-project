# Retail Billing with Multiple Discount Rules

products = []
n = int(input("Enter number of products: "))

subtotal = 0
total_tax = 0
total_discount = 0

for i in range(n):
    print(f"\nEnter details for Product {i + 1}")

    name = input("Product name: ")
    category = input("Category (electronics/clothing/grocery): ").lower()
    price = float(input("Price per unit (Rs.): "))
    quantity = int(input("Quantity: "))

    if price < 0 or quantity <= 0:
        print("Invalid price or quantity. Skipping product.")
        continue

    amount = price * quantity

    # Category-specific tax rates
    if category == "electronics":
        tax_rate = 18
    elif category == "clothing":
        tax_rate = 5
    elif category == "grocery":
        tax_rate = 0
    else:
        tax_rate = 12

    # Threshold discount rules
    if amount >= 10000:
        discount_rate = 15
    elif amount >= 5000:
        discount_rate = 10
    elif amount >= 2000:
        discount_rate = 5
    else:
        discount_rate = 0

    discount = amount * discount_rate / 100

    products.append({
        "name": name,
        "category": category,
        "price": price,
        "quantity": quantity,
        "amount": amount,
        "tax_rate": tax_rate,
        "discount": discount
    })

    subtotal += amount
    total_discount += discount

# Maximum concession limit
max_concession = subtotal * 0.20

if total_discount > max_concession:
    total_discount = max_concession

# Calculate taxes after discount, proportionally adjusting discounts
for product in products:
    if subtotal > 0:
        item_discount = (
            product["discount"] * total_discount / sum(
                p["discount"] for p in products
            )
        ) if sum(p["discount"] for p in products) > 0 else 0
    else:
        item_discount = 0

    taxable_amount = product["amount"] - item_discount
    tax = taxable_amount * product["tax_rate"] / 100

    product["item_discount"] = item_discount
    product["tax"] = tax
    product["net_amount"] = taxable_amount + tax

    total_tax += tax

grand_total = subtotal - total_discount + total_tax

print("\n" + "=" * 75)
print("                    RETAIL INVOICE")
print("=" * 75)

print(
    f"{'Product':<15}{'Category':<15}{'Qty':>5}"
    f"{'Amount':>10}{'Discount':>10}{'Tax':>8}{'Total':>12}"
)
print("-" * 75)

for p in products:
    print(
        f"{p['name'][:14]:<15}{p['category'][:14]:<15}"
        f"{p['quantity']:>5}"
        f"{p['amount']:>10.2f}"
        f"{p['item_discount']:>10.2f}"
        f"{p['tax']:>8.2f}"
        f"{p['net_amount']:>12.2f}"
    )

print("-" * 75)
print(f"{'Subtotal:':<25} Rs. {subtotal:.2f}")
print(f"{'Total Discount:':<25} Rs. {total_discount:.2f}")
print(f"{'Total Tax:':<25} Rs. {total_tax:.2f}")
print("=" * 75)
print(f"{'GRAND TOTAL:':<25} Rs. {grand_total:.2f}")
print("=" * 75)
