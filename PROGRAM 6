# Railway Fare and Reservation Calculator

passengers = []

n = int(input("Enter number of passengers: "))
distance = float(input("Enter travel distance (km): "))

if n <= 0 or distance <= 0:
    print("Invalid number of passengers or travel distance.")
    exit()

print("\nTravel Classes:")
print("1. Sleeper")
print("2. AC 3 Tier")
print("3. AC 2 Tier")
print("4. AC First Class")

class_rates = {
    1: 1.00,
    2: 2.00,
    3: 3.00,
    4: 5.00
}

class_names = {
    1: "Sleeper",
    2: "AC 3 Tier",
    3: "AC 2 Tier",
    4: "AC First Class"
}

if distance <= 100:
    base_rate = 1.00
elif distance <= 500:
    base_rate = 1.50
elif distance <= 1000:
    base_rate = 2.00
else:
    base_rate = 2.50

for i in range(n):
    print(f"\nPassenger {i + 1}")

    name = input("Passenger name: ")
    age = int(input("Age: "))

    print("Select travel class (1-4)")
    travel_class = int(input("Class: "))

    if age < 0 or travel_class not in class_rates:
        print("Invalid age or travel class. Skipping passenger.")
        continue

    cancellation = input(
        "Cancel ticket? (yes/no): "
    ).lower()

    fare = distance * base_rate * class_rates[travel_class]

    concession = 0

    if age < 5:
        fare = 0
    elif age >= 60:
        concession = fare * 0.40
    elif age < 12:
        concession = fare * 0.50

    reservation_fee = 40 if fare > 0 else 0
    total_fare = fare - concession + reservation_fee

    cancellation_penalty = 0

    if cancellation == "yes":
        cancellation_penalty = min(total_fare * 0.25, total_fare)
        final_amount = total_fare - cancellation_penalty
    else:
        final_amount = total_fare

    passengers.append({
        "name": name,
        "age": age,
        "class": class_names[travel_class],
        "fare": fare,
        "concession": concession,
        "reservation_fee": reservation_fee,
        "total": total_fare,
        "penalty": cancellation_penalty,
        "final": final_amount,
        "cancelled": cancellation == "yes"
    })

print("\n========== RAILWAY FARE STATEMENT ==========")

for p in passengers:
    print("\nPassenger:", p["name"])
    print("Age:", p["age"])
    print("Travel Class:", p["class"])
    print(f"Base Fare: Rs. {p['fare']:.2f}")
    print(f"Age Concession: Rs. {p['concession']:.2f}")
    print(f"Reservation Fee: Rs. {p['reservation_fee']:.2f}")
    print(f"Total Fare: Rs. {p['total']:.2f}")

    if p["cancelled"]:
        print(f"Cancellation Penalty: Rs. {p['penalty']:.2f}")
        print(f"Refund Amount: Rs. {p['final']:.2f}")
    else:
        print(f"Amount Payable: Rs. {p['final']:.2f}")

print("\n========== SUMMARY ==========")
print("Passengers processed:", len(passengers))
print("Tickets cancelled:", sum(p["cancelled"] for p in passengers))
print(
    f"Total Fare: Rs. "
    f"{sum(p['total'] for p in passengers):.2f}"
)
print(
    f"Total Cancellation Penalties: Rs. "
    f"{sum(p['penalty'] for p in passengers):.2f}"
)
print(
    f"Total Refund Amount: Rs. "
    f"{sum(p['final'] for p in passengers if p['cancelled']):.2f}"
)

